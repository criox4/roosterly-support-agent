  "cards": [
    {
      "dot": "rose",
      "title": "Forces a handoff",
      "items": [
        "Client rule flagged by any sample, or a nl/en/de keyword",
        "P1, samples disagree, no FAQ cited, confidence < 0.7",
        "Reply check fails: language, claim, promise, link, payment detail"
      ]
    },
    {
      "dot": "cyan",
      "title": "Reliability",
      "items": [
        "429: 4 calls/s throttle, then wait Retry-After",
        "503 / network: jittered backoff, 8 tries",
        "409: counts as already handled, never a second answer",
        "Crash: each ticket is a checkpointed LangGraph thread and resumes at its last step"
      ]
    }
